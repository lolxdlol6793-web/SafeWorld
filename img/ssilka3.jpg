cess","fetchStatus":"idle"},"queryKey":[{"url":"/api/v2/analytics/get"},{"country":"RU","region":77}],"queryHash":"[{\"url\":\"/api/v2/analytics/get\"},{\"country\":\"RU\",\"region\":77}]"},{"dehydratedAt":1778935569483,"state":{"data":{"searchSessionId":"933c1935357ec5a0","events":[{"id":11588234,"name":"Голосование за благоустройство 2026","categories":[{"id":26,"title":"Урбанистика","bgIcon":"https://dobro.ru/assets/build/img/icons/category/urban.svg","bgIconGray":"https://dobro.ru/assets/build/img/icons/category/gray/urban.svg","bgIconPNG":"https://dobro.ru/assets/build/img/icons/category/urban.png","bgIconGrayPNG":"https://dobro.ru/assets/build/img/icons/category/gray/urban.png","bgColor":"#6D14C6"}],"eventPeriod":{"prevDate":null,"prevTime":null,"periodChangeType":null,"shortTitle":"21 апреля – 12 июня 2026","startDate":"2026-04-21T10:00:00+03:00","endDate":"2026-06-12T18:00:00+03:00","titles":[{"date":"21 апреля – 12 июня 2026","time":"10:00 - 18:00"}]},"imageFile":{"url":"https://storage.yandexcloud.net/dobro-static/prod/images/e5951879-fdd6-404c-e332-71ffc9fc1623.jpeg","id":"e5951879-fdd6-404c-e332-71ffc9fc1623","name":"1ce2e716-fac9-33df-bc95-ebe1a6e2bba1.jpeg","size":23083,"createdAt":"2026-03-02T14:48:43+00:00","updatedAt":"2026-03-02T14:48:43+00:00","expiredAt":"2026-03-03T14:48:43+00:00","docType":null},"description":"\u003cp\u003eВолонтёрский корпус ФКГС - один из крупнейших ежегодных волонтёрских проектов страны. С 2021 года в нём приняли участие более 500 тысяч добровольцев со всей России. За это время в рамках федерального проекта благоустроено более 110 тысяч территорий - парки, скверы, набережные и дворы по всей стране.\r\n\u003c/p\u003e\u003cp\u003eВ российских городах проходит Всероссийское голосование за общественные пространства, которые будут благоустроены в первую очередь: парки, набережные, скверы и другие территории. Именно жители решают, какие места должны измениться и стать комфортнее.\r\n\u003c/p\u003e\u003cp\u003eВолонтёры помогают людям узнать о голосовании, рассказывают о проекте и сопровождают жителей в процессе участия. Благодаря их работе тысячи людей по всей стране принимают участие в развитии своих городов.\r\n\u003c/p\u003e\u003cp\u003eЕсли тебе важно, каким станет твой город, и ты хочешь присоединиться к активному сообществу людей, которые реально меняют пространство вокруг себя, - этот проект для тебя.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eВАЖНО:\u003c/b\u003e после подачи заявки необходимо дождаться ее одобрения и после этого авторизироваться в приложении.\u003c/p\u003e\u003cp\u003e\u003cu\u003eВ случае возникновения вопросов вы можете обратиться:\r\n\u003c/u\u003e\u003c/p\u003e\u003cp\u003e1. По статусу заявки на мероприятие и дальнейшим инструкциям - к организаторам мероприятия по почте region@dobro.ru\u003c/p\u003e\u003cp\u003e2. По работе мобильного приложения \"Госуслуги волонтер\" - в Бот поддержки:\r\n\u003c/p\u003e\u003cp\u003eБот поддержки в MAX: https://max.ru/fkgs_volunteer_support_bot\r\n\u003c/p\u003e\u003cp\u003eБот поддержки в Telegram: @FKGSsupportBot\r\n\u003c/p\u003e","organizer":{"iconUrl":"https://storage.yandexcloud.net/dobro-static/prod/images/3ed4ed33-ac25-1115-e10c-809d7d8e3202.","id":14,"name":"Ассоциация Добро.рф","statistic":{"organizerRating":4.9}},"location":{"country":"RU","countryName":"Россия","title":"Россия","region":null,"regionName":null,"municipality":null,"municipalityCode":null,"settlement":null,"settlementCode":null,"settlementDistrict":null,"settlementCodeDistrictCode":null,"street":null,"house":null,"flat":null,"fias":null,"x":null,"y":null,"timezone":null,"shortName":"Россия"}},{"id":11602265,"name":"Всероссийский форум развития гражданского общества «Добрино» 2026 год","categories":[{"id":18,"title":"Дети и молодежь","bgIcon":"https://dobro.ru/assets/build/img/icons/category/children.svg","bgIconGray":"https://dobro.ru/assets/build/img/icons/category/gray/children.svg","bgIconPNG":"https://dobro.ru/assets/build/img/icons/category/children.png","bgIconGrayPNG":"https://dobro.ru/assets/build/img/icons/category/gray/children.png","bgColor":"#C6147E"},{"id":29,"title":"Образование","bgIcon":"https://dobro.ru/assets/build/img/icons/category/education.svg","bgIconGray":"https://dobro.ru/assets/build/img/icons/category/gray/education.svg","bgIconPNG":"https://dobro.ru/assets/build/img/icons/category/education.png","bgIconGrayPNG":"https://dobro.ru/assets/build/img/icons/category/gray/education.png","bgColor":"#2214C6"}],"eventPeriod":{"prevDate":null,"prevTime":null,"periodChangeType":null,"shortTitle":"1 – 14 июля 2026","startDate":"2026-07-01T10:00:00+05:00","endDate":"2026-07-14T18:00:00+05:00","titles":[{"date":"1 – 14 июля 2026","time":"10:00 - 18:00"}]},"imageFile":{"url":"https://storage.yandexcloud.net/dobro-static/prod/images/e6232c26-9962-a182-8e6d-ac6ff1a297d3.jpg","id":"e6232c26-9962-a182-8e6d-ac6ff1a297d3","name":"8ec7fd22-90a4-9e9f-9c13-cf0369c8aeb6.jpg","size":27123,"createdAt":"2026-04-23T16:18:42+00:00","updatedAt":"2026-04-23T16:18:42+00:00","expiredAt":"2026-04-24T16:18:42+00:00","docType":null},"description":"\u003cp\u003e\u003cb\u003eОБРАТИ ВНИМАНИЕ: \u003c/b\u003eв этом году наш Форум пройдет в формате трёх тематических смен, и тебе важно помнить: участвовать в Форуме можно только в одной смене. Во второй смене участвуют только региональные команды.\u003c/p\u003e\u003cp\u003e\u003cb\u003eС 1 по 14 июля 2026 года в Ханты-Мансийске пройдёт Всероссийский форум развития гражданского общества «Добрино»\u003c/b\u003e\u003cspan\u003e — флагманский проект Академии развития гражданского общества «Добрино».\u0026nbsp;\u003c/span\u003e\u003cspan\u003eВ 2026 году Форум соберёт 500 участников со всех регионов России: добровольцев, представителей некоммерческих организаций, органов власти, бизнеса, образовательных учреждений, наставников и лидеров общественных инициатив в возрасте от 18 до 35 лет.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cb\u003eФорум проходит в формате трёх тематических смен\u003c/b\u003e\u003cspan\u003e — от первых шагов молодёжи в некоммерческом секторе до разработки и тиражирования комплексных региональных решений и развития команды проводников смыслов Академии «Добрино».\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cu\u003e\u003cb\u003eКаждая смена уникальна!\u003c/b\u003e\u003c/u\u003e\u003c/p\u003e\u003cp\u003e\u003cb\u003eСмена 1. «Молодые НКО и координаторы проектов»\r\n\u003c/b\u003e\u003c/p\u003e\u003cp\u003eДля кого: организаторы социальных проектов, сотрудники и руководители молодых НКО, координаторы работы с волонтерами и волонтерскими проектами, в том числе обучающиеся вузов и колледжей, преподаватели в возрасте от 18 до 35 лет.\u003c/p\u003e\u003cp\u003e\u003cb\u003eСмена 2. «Добро.Конференция»\u003c/b\u003e\u003c/p\u003e\u003cp\u003eДля кого: региональные команды из 3–7 человек из одного региона. В состав команды могут входить представители ресурсных центров развития добровольчества и поддержки НКО, Добро.Центров, движения #МЫВМЕСТЕ, исполнительных органов и лидеры добровольческих организаций на муниципальном уровне, в том числе обучающиеся вузов и колледжей, преподаватели в возрасте от 18 до 35 лет.\u003c/p\u003e\u003cp\u003e\u003cb\u003eСмена 3. «Проводники смыслов»\u003c/b\u003e\u003c/p\u003e\u003cp\u003eДля кого: общественные лидеры и активные добровольцы с большой аудиторией в социальных сетях или сообществ, а также лидеры социальных проектов, представители крупных федеральных движений, в том числе обучающиеся вузов и колледжей, преподаватели в возрасте от 18 до 35 лет.\u003cbr\u003e\u003cbr\u003eМы приглашаем тех, кто умеет заряжать добром, находить решение любой задачи и превращать даже самую сложную работу в праздник.\u003c/p\u003e\u003cp\u003e\u003cb\u003e\r\n\u003c/b\u003e\u003c/p\u003e\u003cp\u003e\u003cb\u003e\r\n\u003c/b\u003e\u003c/p\u003e\u003cp\u003e\u003cb\u003e\r\n\u003c/b\u003e\u003c/p\u003e\u003cp\u003e\u003cb\u003e\r\n\u003c/b\u003e\u003c/p\u003e\u003cp\u003e\u003cb\u003e\r\n\u003c/b\u003e\u003c/p\u003e","organizer":{"iconUrl":"https://storage.yandexcloud.net/dobro-static/prod/images/3baef299-75c5-9a87-e6b1-6e0276c8837e.png","id":18168479,"name":"Академия развития гражданского общества «Добрино»","statistic":{"organizerRating":5}},"location":{"country":"RU","countryName":"Россия","title":"Ханты-Мансийский Автономный округ - Югра, г Ханты-Мансийск","region":86,"regionName":"Ханты-Мансийский автономный округ - Югра","municipality":null,"municipalityCode":null,"settlement":"Ханты-Мансийск","settlementCode":"8600000100000","settlementDistrict":null,"settlementCodeDistrictCode":null,"street":null,"house":null,"flat":null,"fias":null,"x":69.018337,"y":61.00256,"timezone":"Asia/Yekaterinburg","shortName":"Ханты-Мансийск"}},{"id":11628384,"name":"Ликвидация происшествия в Республике Дагестан","categories":[{"id":15,"title":"Здравоохранение и ЗОЖ","bgIcon":"https://dobro.ru/assets/build/img/icons/category/health.svg","bgIconGray":"https://dobro.ru/assets/build/img/icons/category/gray/health.svg","bgIconPNG":"https://dobro.ru/assets/build/img/icons/category/health.png","bgIconGrayPNG":"https://dobro.ru/assets/build/img/icons/category/gray/health.png","bgColor":"#C51232"},{"id":16,"title":"ЧС","bgIcon":"https://dobro.ru/assets/build/img/icons/category/911.svg","bgIconGray":"https://dobro.ru/assets/build/img/icons/category/gray/911.svg","bgIconPNG":"https://dobro.ru/assets/build/img/icons/category/911.png","bgIconGrayPNG":"https://dobro.ru/assets/build/img/icons/category/gray/911.png","bgColor":"#C51212"},{"id":18,"title":"Дети и молодежь","bgIcon":"https://dobro.ru/assets/build/img/icons/category/children.svg","bgIconGray":"https://dobro.ru/assets/build/img/icons/category/gray/children.svg","bgIconPNG":"https://dobro.ru/assets/build/img/icons/category/children.png","bgIconGrayPNG":"https://dobro.ru/assets/build/img/icons/category/gray/children.png","bgColor":"#C6147E"}],"eventPeriod":{"prevDate":null,"prevTime":null,"periodChangeType":null,"shortTitle":"28 марта – 19 